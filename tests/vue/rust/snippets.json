    "n.value = 2;",
    "log('end', typeof h.stop);"
  ]},
  {"id": "watch-deep-numeric-depth", "lines": [
    "const {ref, watch} = R;",
    "const leaf = ref(0);",
    "const root = {level1: {level2: {leaf: leaf}}};",
    "let shallowCalls = 0;",
    "let deepCalls = 0;",
    "watch(() => root, () => { shallowCalls++; }, {deep: 3});",
    "watch(() => root, () => { deepCalls++; }, {deep: 4});",
    "leaf.value = 1;",
    "log('calls', shallowCalls, deepCalls);"
  ]},
  {"id": "watch-deep-cycle-terminates", "lines": [
    "const {ref, watch} = R;",
