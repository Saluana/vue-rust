    "const useA = ref(true);",
    "const a = ref('A0');",
    "const b = ref('B0');",
    "let calls = 0;",
    "const pick = computed(() => { calls++; return useA.value ? a.value : b.value; });",
    "effect(() => log('pick', pick.value));",
    "b.value = 'B1';",
    "log('calls-1', calls);",
    "useA.value = false;",
    "log('calls-2', calls);",
    "a.value = 'A1';",
    "log('calls-3', calls);",
    "b.value = 'B2';",
    "log('calls-4', calls);"
  ]},
  {"id": "computed-error-then-recover", "lines": [
    "const {ref, computed} = R;",
    "const n = ref(0);",
    "const inv = computed(() => { if (n.value === 0) { throw new RangeError('zero'); } return 10 / n.value; });",
    "let first = 'none';",
    "try { inv.value; } catch (e) { first = e.name; }",
    "log('first', first);",
    "n.value = 5;",
    "log('recovered', inv.value);"
  ]},
  {"id": "computed-self-read-previous-value", "lines": [
    "const {ref, computed} = R;",
    "const n = ref(0);",
    "let calls = 0;",
