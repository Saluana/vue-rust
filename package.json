{
  "name": "vue-rust-lab",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "vue-native": "node tooling/cli/vue-native.mjs",
