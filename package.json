    "test:vue": "node tooling/harness/run-language.mjs --with-vue"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@vue/compiler-dom": "3.5.43",
    "@vue/compiler-sfc": "3.5.43"
  },
  "devDependencies": {
    "vue": "3.5.43"
  },
  "bin": {
    "vue-native": "tooling/cli/vue-native.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
